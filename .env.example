# Personal API key for the Linear Longlife workspace.
# With it, `npm run linear:sync` (or POST /api/linear/sync) mirrors Linear projects
# into public.projects, which is the /horas project selector.
# Without it, add new Longlife projects to src/lib/longlifeHoursProjects.js and run
# `npm run linear:ensure-hours-projects`.
LINEAR_API_KEY=
# Optional: OAuth app credentials (webhook setup needs workspace admin token)
